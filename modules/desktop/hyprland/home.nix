{ config, lib, ... }:
{
  imports = [
    ../../programs/wayland/bars/eww/home.nix
    ./stylix-home.nix
    # ../../programs/wayland/bars/waybar/home.nix
    ../../programs/wayland/bars/quickshell/home.nix
    (import ../../environment/hypr-variables.nix)
  ]
  ++ (import ../../programs/wayland/home.nix)
  ++ (import ../../theme/catppuccin-dark/wayland/home.nix);

  home.file.hyprconf = {
    target = ".config/hypr/hyprland.lua";
    text = ''
      ${import ./monitors-decoder.nix {
        inherit lib;
        inherit (config) monitors;
      }}

      ${builtins.readFile ./hyprland.lua}
    '';
  };

  home.sessionVariables.HYPRLAND_CONFIG = "${config.home.homeDirectory}/.config/hypr/hyprland.lua";

  # Hyprland falls back to a stub .conf when no hyprland.lua is found.
  # Remove any stale autogenerated hyprland.conf so it can never take priority.
  home.activation.removeHyprlandConf = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    rm -f "${config.home.homeDirectory}/.config/hypr/hyprland.conf"
  '';
}
